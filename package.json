{
  "name": "shinrai-ai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json && tsc -p tests/e2e/tsconfig.json && tsc -p apps/web/tsconfig.json && tsc -p infra/cdk/tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:eval": "vitest run --project evaluations",
    "test:e2e": "playwright test",
    "build": "pnpm --filter @shinrai/web build",
    "stack:up": "docker compose up -d --wait",
    "stack:down": "docker compose down",
    "db:migrate": "tsx scripts/migrate.ts",
    "dev": "pnpm --parallel --filter @shinrai/api --filter @shinrai/worker --filter @shinrai/web dev",
    "demo": "tsx scripts/demo.ts",
    "demo:replay": "tsx scripts/replay.ts",
    "drill": "tsx scripts/drills.ts",
    "cdk:synth": "pnpm --filter @shinrai/cdk synth",
    "cdk:test": "pnpm --filter @shinrai/cdk test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@shinrai/adapters": "workspace:*",
    "@shinrai/agent-tools": "workspace:*",
    "@shinrai/api": "workspace:*",
    "@shinrai/contracts": "workspace:*",
    "@shinrai/domain": "workspace:*",
    "@shinrai/observability": "workspace:*",
    "@shinrai/worker": "workspace:*",
    "@testcontainers/postgresql": "12.2.1",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jiti": "2.7.0",
    "prettier": "3.9.10",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
