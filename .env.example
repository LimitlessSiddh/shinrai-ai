# Copy to .env for local development. Every value here is a safe local placeholder.
# Never put real provider keys in this file or commit a filled-in .env.

DATABASE_URL=postgres://shinrai:shinrai_local@localhost:55432/shinrai
NATS_URL=nats://localhost:4222
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Local-only bearer tokens -> principal. Rejected when SHINRAI_PROFILE=aws.
# Format: token=tenant:actorId:kind:scope1|scope2;...
SHINRAI_PROFILE=local
SHINRAI_DEV_TOKENS=dev-operator-local-only=demo:operator:human:read|trade|resolve|replay|approve;dev-agent-research-local-only=demo:agent-research:agent:read|agent
NEXT_PUBLIC_OPERATOR_TOKEN=dev-operator-local-only

# Model runner: "fake" (default, deterministic, offline) or "openai" (opt-in, capped).
SHINRAI_MODEL=fake
OPENAI_API_KEY=
SHINRAI_MODEL_MAX_TOOL_CALLS=8
SHINRAI_MODEL_MAX_RUNS_PER_DAY=5

# Optional OpenTelemetry export (start with: docker compose --profile otel up)
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
